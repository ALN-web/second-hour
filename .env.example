# Copy to .env and fill in. Never commit .env.
# Neon PostgreSQL connection string (falls back to local SQLite if unset)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
MCP_SERVER_URL=http://localhost:8001/mcp
DATA_DIR=./data
# Optional: ElevenLabs voice read-out of agent replies
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Deployment Environment: development | staging | production
ENVIRONMENT=development

# Presenter controls (reset + stage synthetic demo cases). Strictly disabled (0) by default.
DEMO_MODE=0

# Server-side HMAC Secret for OTP verification (generate with: openssl rand -hex 32)
# NEVER commit the real secret. Required in staging and production.
OTP_HMAC_SECRET=replace-with-a-secure-32-byte-hex-key

# Server-side 256-bit encryption key for OAuth tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# NEVER commit the real secret. Required in staging and production.
TOKEN_ENCRYPTION_KEY=replace-with-a-secure-fernet-key

# Verification Provider Execution Mode: MOCK | SANDBOX | PRODUCTION (defaults to MOCK)
# MOCK: Safe simulated workflows for testing; documents & vehicles NEVER receive 'verified' status.
# SANDBOX: Distinguishable sandbox verification; does not mark records production-verified.
# PRODUCTION: Real institutional verification with official credentials; fails closed if credentials missing.
VERIFICATION_PROVIDER_MODE=MOCK

# Institutional Verification Provider Credentials (Required only when VERIFICATION_PROVIDER_MODE=PRODUCTION)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_API_BASE=https://digilocker.meripehchaan.gov.in/public/oauth2/1
DIGILOCKER_AUTH_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_REVOKE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/revoke
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/verify/digilocker/callback
DIGILOCKER_SCOPES=read

VAHAN_API_KEY=
VAHAN_API_URL=https://api.parivahan.gov.in/vahan4

IIB_API_KEY=
IIB_API_URL=https://api.iib.gov.in/v1

# ==============================================================================
# OTP Delivery Configuration (Email & SMS)
# ==============================================================================

# --- Email OTP Delivery ---
# Provider: SMTP (default) | RESEND | MOCK (development only)
EMAIL_PROVIDER=SMTP

# SMTP Configuration (Compatible with SendGrid, AWS SES, Brevo, Postmark, Mailgun, or standard SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@secondhour.in
SMTP_FROM_NAME=Second Hour
SMTP_TIMEOUT_SECONDS=10.0

# Optional: Resend REST API Email Provider (used if EMAIL_PROVIDER=RESEND or RESEND_API_KEY configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@secondhour.in

# --- SMS OTP Delivery ---
# Provider: TWILIO (default) | MSG91 | MOCK (development only)
SMS_PROVIDER=TWILIO
SMS_TIMEOUT_SECONDS=10.0

# Twilio SMS Gateway Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# MSG91 SMS Gateway Configuration (India TRAI DLT Compliant)
# Requirements under TRAI TCCCPR Regulations:
# 1. Register Principal Entity on Indian Telecom DLT portal (Jio, Airtel, Vodafone Idea, or BSNL DLT).
# 2. Register Header / Sender ID (6-character alphabetic header, e.g. SECHOR).
# 3. Register Service Implicit OTP Template and obtain Template ID.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SECHOR
MSG91_DLT_TE_ID=
MSG91_OTP_URL=https://control.msg91.com/api/v5/otp
